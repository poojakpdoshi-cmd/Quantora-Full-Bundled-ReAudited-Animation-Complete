# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
# DISABLED_TO_TRACK_ALL: *.apk
# DISABLED_TO_TRACK_ALL: *.aar
# DISABLED_TO_TRACK_ALL: *.ap_
# DISABLED_TO_TRACK_ALL: *.aab

# Files for the ART/Dalvik VM
# DISABLED_TO_TRACK_ALL: *.dex

# Java class files
# DISABLED_TO_TRACK_ALL: *.class

# Generated files
# DISABLED_TO_TRACK_ALL: bin/
# DISABLED_TO_TRACK_ALL: gen/
# DISABLED_TO_TRACK_ALL: out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
# DISABLED_TO_TRACK_ALL: .gradle/
# DISABLED_TO_TRACK_ALL: build/

# Local configuration file (sdk path, etc)
# DISABLED_TO_TRACK_ALL: local.properties

# Proguard folder generated by Eclipse
# DISABLED_TO_TRACK_ALL: proguard/

# Log Files
# DISABLED_TO_TRACK_ALL: *.log

# Android Studio Navigation editor temp files
# DISABLED_TO_TRACK_ALL: .navigation/

# Android Studio captures folder
# DISABLED_TO_TRACK_ALL: captures/

# IntelliJ
# DISABLED_TO_TRACK_ALL: *.iml
# DISABLED_TO_TRACK_ALL: .idea/workspace.xml
# DISABLED_TO_TRACK_ALL: .idea/tasks.xml
# DISABLED_TO_TRACK_ALL: .idea/gradle.xml
# DISABLED_TO_TRACK_ALL: .idea/assetWizardSettings.xml
# DISABLED_TO_TRACK_ALL: .idea/dictionaries
# DISABLED_TO_TRACK_ALL: .idea/libraries
# Android Studio 3 in .gitignore file.
# DISABLED_TO_TRACK_ALL: .idea/caches
# DISABLED_TO_TRACK_ALL: .idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
# DISABLED_TO_TRACK_ALL: .idea/navEditor.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
# DISABLED_TO_TRACK_ALL: .externalNativeBuild
# DISABLED_TO_TRACK_ALL: .cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
# DISABLED_TO_TRACK_ALL: freeline.py
# DISABLED_TO_TRACK_ALL: freeline/
# DISABLED_TO_TRACK_ALL: freeline_project_description.json

# fastlane
# DISABLED_TO_TRACK_ALL: fastlane/report.xml
# DISABLED_TO_TRACK_ALL: fastlane/Preview.html
# DISABLED_TO_TRACK_ALL: fastlane/screenshots
# DISABLED_TO_TRACK_ALL: fastlane/test_output
# DISABLED_TO_TRACK_ALL: fastlane/readme.md

# Version control
# DISABLED_TO_TRACK_ALL: vcs.xml

# lint
# DISABLED_TO_TRACK_ALL: lint/intermediates/
# DISABLED_TO_TRACK_ALL: lint/generated/
# DISABLED_TO_TRACK_ALL: lint/outputs/
# DISABLED_TO_TRACK_ALL: lint/tmp/
# lint/reports/

# Android Profiling
# DISABLED_TO_TRACK_ALL: *.hprof

# Cordova plugins for Capacitor
# DISABLED_TO_TRACK_ALL: capacitor-cordova-android-plugins

# Copied web assets
# DISABLED_TO_TRACK_ALL: app/src/main/assets/public

# Generated Config files
# DISABLED_TO_TRACK_ALL: app/src/main/assets/capacitor.config.json
# DISABLED_TO_TRACK_ALL: app/src/main/assets/capacitor.plugins.json
# DISABLED_TO_TRACK_ALL: app/src/main/res/xml/config.xml
